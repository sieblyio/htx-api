{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "rootDir": ".",
    "allowJs": true,
    "noEmit": true,
    "types": ["node", "jest"]
  },
  "include": [
    "src/**/*.*",
    "test/**/*.*",
    "examples/**/*.*",
    "eslint.config.cjs",
    "jest.config.cjs"
  ]
}
